# Development: where "npm run dev" forwards /api requests (the Express server).
API_PROXY_TARGET=http://localhost:4000

# Production: leave EMPTY when /api is served on the same domain as this panel (recommended,
# e.g. admin.example.com/api -> API server). Otherwise the full API origin, e.g. https://api.example.com
VITE_API_URL=

# Link to the player website (shown in the sidebar).
VITE_WEB_URL=http://localhost:5173
